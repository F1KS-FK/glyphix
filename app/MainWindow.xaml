<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glyphix" Width="1480" Height="880" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#070A18"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#070A18"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1430"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1C2552"/>
    <SolidColorBrush x:Key="RowBrush" Color="#121A3D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A93BD"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#141B3D"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#1D2757"/>
    <SolidColorBrush x:Key="GhostBorderBrush" Color="#2A3366"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#6A5CFF" Offset="0"/>
      <GradientStop Color="#3D8BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Основная кнопка: градиент + мягкое свечение -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#6A5CFF" Opacity="0.35" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="14"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмная вторичная кнопка -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#3D8BFF" Opacity="0" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="12"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0.25"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ссылка автора в шапке: светло-синяя, при наведении подчёркивается -->
    <Style x:Key="AuthorLink" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="#7FB0FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextDecorations" Value="None"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#A9C8FF"/>
          <Setter Property="TextDecorations" Value="Underline"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Height="24" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмные полосы прокрутки -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" CornerRadius="4" Background="#2A3366" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#3D4A8C"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 3.0: градиенты секций, компактные кнопки строк плана, чипы фильтров, поле поиска ===== -->
    <LinearGradientBrush x:Key="SectionBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#0D1534" Offset="0"/>
      <GradientStop Color="#0A0F26" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SectionTitleBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#A9B8FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SectionBorderBrush" Color="#18224D"/>
    <SolidColorBrush x:Key="StarBrush" Color="#FFC857"/>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <!-- маленькая тёмная кнопка (режимы и стиль в строке плана, меню выбора) -->
    <Style x:Key="MiniButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource GhostBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GhostBorderBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModeIconButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconMode}" Value="skip">
          <Setter Property="Foreground" Value="#7C86B3"/>
          <Setter Property="Background" Value="#0E1430"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconMode}" Value="restore">
          <Setter Property="Foreground" Value="#FFC857"/>
          <Setter Property="BorderBrush" Value="#5A4A22"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ModeTileButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding TileMode}" Value="skip">
          <Setter Property="Foreground" Value="#7C86B3"/>
          <Setter Property="Background" Value="#0E1430"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TileMode}" Value="restore">
          <Setter Property="Foreground" Value="#FFC857"/>
          <Setter Property="BorderBrush" Value="#5A4A22"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StyleButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding StyleCustom}" Value="True">
          <Setter Property="Foreground" Value="#B3A9FF"/>
          <Setter Property="BorderBrush" Value="#4B4690"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- чип-переключатель фильтра («Все · 120») -->
    <Style x:Key="ChipRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="13" Height="26" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" Padding="12,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- круглые стрелки ‹ › по краям ряда карточек -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="19" Background="#E60E1430" BorderBrush="#3D4A8C" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F01D2757"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- поле поиска (подсказка - отдельный TextBlock поверх, его прячет код) -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="12,0,12,0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#6A5CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- элемент списка без подсветки выбора (строки плана - не выбираемые) -->
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- строка плана «Что поменяется»: одно приложение. Привязка к GlyphixGui.PlanRow; клики ловит ListBox (Tag: chk | icon | tile | style) -->
    <DataTemplate x:Key="PlanRowTemplate">
      <Border Background="{StaticResource RowBrush}" CornerRadius="10" Margin="0,0,6,6" Padding="10,8,10,8" Height="104" ToolTip="{Binding Tip}" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Style="{StaticResource DarkCheck}" Tag="chk" IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="46" Height="46" CornerRadius="9" Background="#0A0F26">
              <Image Source="{Binding BeforeImage}" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="→" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="6,0,6,2"/>
            <Border Width="46" Height="46" CornerRadius="9" Background="#0A0F26">
              <Image Source="{Binding AfterImage}" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="26"/>
              <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#8A93BD"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="replace">
                        <Setter Property="Foreground" Value="#7FB0FF"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="current">
                        <Setter Property="Foreground" Value="#5BD39A"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="missing">
                        <Setter Property="Foreground" Value="#FFC857"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" VerticalAlignment="Center" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="7" Background="#1A2350" Padding="8,2" Margin="0,0,5,0">
                    <TextBlock Text="{Binding}" Foreground="#AEB7E0" FontSize="11"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button Grid.Column="0" Style="{StaticResource ModeIconButton}" Tag="icon" ToolTip="Что делать с иконкой ярлыков этого приложения" Visibility="{Binding HasIcon, Converter={StaticResource B2V}}">
                <TextBlock><Run Text="Иконка: " Foreground="#8A93BD"/><Run Text="{Binding IconModeText, Mode=OneWay}"/><Run Text=" ▾" Foreground="#8A93BD"/></TextBlock>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource ModeTileButton}" Tag="tile" ToolTip="Что делать с плиткой Start11 этого приложения" Visibility="{Binding HasTile, Converter={StaticResource B2V}}">
                <TextBlock><Run Text="Плитка: " Foreground="#8A93BD"/><Run Text="{Binding TileModeText, Mode=OneWay}"/><Run Text=" ▾" Foreground="#8A93BD"/></TextBlock>
              </Button>
              <Button Grid.Column="2" Style="{StaticResource StyleButton}" Tag="style" ToolTip="Взять иконку этого приложения из другого стиля" HorizontalAlignment="Right" MaxWidth="240" Visibility="{Binding CanStyle, Converter={StaticResource B2V}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding StyleText}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text=" ▾"/>
                </Grid>
              </Button>
            </WrapPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Шапка: логотип | название + автор (контакты) | кнопка обновления приложения | статус прав -->
    <Grid Grid.Row="0" Margin="28,18,28,8" MinHeight="48">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="ImgLogo" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Grid Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- название и контакты автора рядом: «GLYPHIX» + плашка контактов автора: by F1KS, Telegram (ссылка), Discord (щелчок копирует ник) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="GLYPHIX" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#9C92FF" Offset="0"/>
                <GradientStop Color="#6DB0FF" Offset="1"/>
              </LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>
          <Border Margin="14,2,0,0" Height="26" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,0" VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"><Run FontWeight="SemiBold" Text="by F1KS"/><Run Foreground="{StaticResource MutedBrush}" Text="  ·  Telegram "/><Hyperlink x:Name="LnkAuthor" Style="{StaticResource AuthorLink}" NavigateUri="https://t.me/Im_Flawless">@Im_Flawless</Hyperlink><Run Foreground="{StaticResource MutedBrush}" Text="  ·  Discord "/><Hyperlink x:Name="LnkDiscord" Style="{StaticResource AuthorLink}" ToolTip="Нажмите, чтобы скопировать ник"><Run x:Name="RunDiscord" Text="f1ks_"/></Hyperlink></TextBlock>
          </Border>
        </StackPanel>
        <TextBlock x:Name="TxtVersion" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,2,0,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <!-- появляется, только если на GitHub есть версия новее -->
      <Button x:Name="BtnAppUpdate" Grid.Column="2" Style="{StaticResource AccentButton}" Visibility="Collapsed" MinWidth="240" MaxWidth="460" Margin="0,0,14,0" Padding="18,0" VerticalAlignment="Center"/>
      <Border Grid.Column="3" Height="26" MinWidth="120" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,0" VerticalAlignment="Center">
        <TextBlock x:Name="TxtAdmin" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- Основная часть: стили (слева, секциями) | что поменяется (справа: 3/8 ширины, но 520-720) -->
    <Grid Grid.Row="1" Margin="20,6,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="360"/>
        <ColumnDefinition Width="3*" MinWidth="520" MaxWidth="720"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="8,0,6,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtPacksTitle" Grid.Column="0" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Grid Grid.Column="1" Width="300">
            <TextBox x:Name="TxtPackSearch" Style="{StaticResource SearchBox}" MaxLength="60"/>
            <TextBlock x:Name="TxtPackSearchHint" Foreground="#5F688F" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <!-- панель выбора нескольких стилей: «Выбрано: N · Скачать выбранные · Выбрать все · Снять» -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,0,8">
          <TextBlock x:Name="TxtSelCount" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="BtnSelDownload" Style="{StaticResource AccentButton}" Height="28" MinWidth="150" Padding="14,0" FontSize="12" Margin="0,2,10,2"/>
          <Button x:Name="BtnSelAll" Style="{StaticResource GhostButton}" Height="28" MinWidth="100" Padding="12,0" FontSize="12" Margin="0,2,10,2"/>
          <Button x:Name="BtnSelNone" Style="{StaticResource GhostButton}" Height="28" MinWidth="80" Padding="12,0" FontSize="12" Margin="0,2,0,2"/>
        </WrapPanel>
        <!-- вертикальный список секций (одна секция - одно семейство стилей, в ней ряд карточек с горизонтальной прокруткой); секции строятся из кода по одной -->
        <ScrollViewer x:Name="ScrSections" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="SectionsHost" Margin="0,0,6,12"/>
        </ScrollViewer>
        <TextBlock x:Name="TxtEmpty" Grid.Row="2" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed"/>
      </Grid>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,16,10,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,6,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="26"/>
              <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtMatchTitle" Grid.Row="0" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtSelectedPack" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <!-- фильтры плана: Все · Заменятся · Уже стоят · Нет в паке (с счётчиками) -->
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,6,0">
            <RadioButton x:Name="RbAll" GroupName="PlanFilter" Style="{StaticResource ChipRadio}" IsChecked="True"/>
            <RadioButton x:Name="RbReplace" GroupName="PlanFilter" Style="{StaticResource ChipRadio}"/>
            <RadioButton x:Name="RbCurrent" GroupName="PlanFilter" Style="{StaticResource ChipRadio}"/>
            <RadioButton x:Name="RbMissing" GroupName="PlanFilter" Style="{StaticResource ChipRadio}"/>
          </WrapPanel>
          <Grid Grid.Row="2" Margin="0,0,6,10">
            <TextBox x:Name="TxtPlanSearch" Style="{StaticResource SearchBox}" MaxLength="60" Height="32"/>
            <TextBlock x:Name="TxtPlanSearchHint" Foreground="#5F688F" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <!-- одна строка = одно приложение; список виртуализуется (создаются только видимые строки) -->
          <ListBox x:Name="PlanList" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                   ItemTemplate="{StaticResource PlanRowTemplate}" ItemContainerStyle="{StaticResource PlainItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                   VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
          <TextBlock x:Name="TxtPlanEmpty" Grid.Row="3" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" Visibility="Collapsed"/>
          <Grid Grid.Row="4" Margin="0,8,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkPlanAll" Grid.Column="0" Style="{StaticResource DarkCheck}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtPlanSel" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,10,0" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="BtnUndoSel" Grid.Column="2" Style="{StaticResource GhostButton}" Height="30" MinWidth="170" Padding="14,0" FontSize="12"/>
          </Grid>
          <TextBlock x:Name="TxtMatchSummary" Grid.Row="5" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,6,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Панель действий: ряд 1 - кнопки, ряд 2 - галочки; все колонки заданы явно -->
    <Grid Grid.Row="2" Margin="28,4,28,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto" MinHeight="30"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnUpdate" Grid.Column="0" Style="{StaticResource AccentButton}" MinWidth="140" Margin="0,0,10,0"/>
        <Button x:Name="BtnUndo" Grid.Column="1" Style="{StaticResource GhostButton}" MinWidth="130" Margin="0,0,10,0"/>
        <Button x:Name="BtnOpen" Grid.Column="2" Style="{StaticResource GhostButton}" MinWidth="140" Margin="0,0,10,0"/>
        <Button x:Name="BtnMenu" Grid.Column="3" Style="{StaticResource GhostButton}" Content="⋯" MinWidth="44" Width="44" Padding="0"/>
        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12">
          <Hyperlink x:Name="LnkGitHub" NavigateUri="https://github.com/F1KS-FK/glyphix" Foreground="#7F9BFF" TextDecorations="None">GitHub</Hyperlink>
        </TextBlock>
      </Grid>
      <!-- галочки: в WrapPanel, на узком окне переносятся на вторую строку -->
      <WrapPanel Grid.Row="1" Orientation="Horizontal">
        <CheckBox x:Name="ChkRestart" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,24,3"/>
        <CheckBox x:Name="ChkAllUsers" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Margin="0,3,24,3"/>
        <CheckBox x:Name="ChkTiles" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,24,3" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkNoName" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Margin="0,3,24,3" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkAuto" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,0,3"/>
      </WrapPanel>
      <Popup x:Name="PopMenu" PlacementTarget="{Binding ElementName=BtnMenu}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="8">
          <StackPanel>
            <Button x:Name="BtnReport" Style="{StaticResource GhostButton}" MinWidth="200" Margin="0,0,0,6"/>
            <Button x:Name="BtnClearCache" Style="{StaticResource GhostButton}" MinWidth="200" Margin="0,0,0,6"/>
            <Button x:Name="BtnUninstall" Style="{StaticResource GhostButton}" MinWidth="200"/>
          </StackPanel>
        </Border>
      </Popup>
      <!-- общее всплывающее меню выбора: режим иконки / плитки, стиль приложения (наполняется из кода) -->
      <Popup x:Name="PopChoice" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="8">
          <ScrollViewer MaxHeight="440" MaxWidth="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="PopChoiceItems" MinWidth="170"/>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <!-- Статус и журнал: высота строки статуса фиксирована, длинный текст обрезается многоточием (полный - во всплывающей подсказке) -->
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="4"/>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ProgressBar x:Name="PrgBusy" Grid.Row="0" Height="4" Minimum="0" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
      <Grid Grid.Row="1" Margin="28,0,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="TxtPct" Grid.Column="1" Foreground="#9C92FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button x:Name="BtnLog" Grid.Column="2" Style="{StaticResource GhostButton}" Height="26" MinWidth="88" Padding="12,0" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="LogPanel" Grid.Row="2" Visibility="Collapsed" Margin="28,0,28,16" Background="#050815" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
        <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#AEB7E0" FontFamily="Consolas" FontSize="12" Padding="10,8"/>
      </Border>
    </Grid>
  </Grid>
</Window>
