<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glyphix" Width="1120" Height="720" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#070A18"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#070A18"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1430"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1C2552"/>
    <SolidColorBrush x:Key="RowBrush" Color="#121A3D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A93BD"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#141B3D"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#1D2757"/>
    <SolidColorBrush x:Key="GhostBorderBrush" Color="#2A3366"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#6A5CFF" Offset="0"/>
      <GradientStop Color="#3D8BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Основная кнопка: градиент + мягкое свечение -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#6A5CFF" Opacity="0.35" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="14"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмная вторичная кнопка -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#3D8BFF" Opacity="0" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="12"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0.25"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Height="24" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмные полосы прокрутки -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" CornerRadius="4" Background="#2A3366" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#3D4A8C"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Шапка: логотип | название | кнопка обновления приложения | статус прав -->
    <Grid Grid.Row="0" Margin="28,20,28,10" Height="48">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="ImgLogo" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Grid Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="GLYPHIX" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#9C92FF" Offset="0"/>
              <GradientStop Color="#6DB0FF" Offset="1"/>
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock x:Name="TxtVersion" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,1,0,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <!-- появляется, только если на GitHub есть версия новее; место в шапке зарезервировано высотой 48, ничего не сдвигается -->
      <Button x:Name="BtnAppUpdate" Grid.Column="2" Style="{StaticResource AccentButton}" Visibility="Collapsed" MinWidth="240" MaxWidth="460" Margin="0,0,14,0" Padding="18,0" VerticalAlignment="Center"/>
      <Border Grid.Column="3" Height="26" MinWidth="120" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="12,0" VerticalAlignment="Center">
        <TextBlock x:Name="TxtAdmin" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- Основная часть: паки (слева) | что поменяется (справа, 400-520) -->
    <Grid Grid.Row="1" Margin="20,6,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="320"/>
        <ColumnDefinition Width="*" MinWidth="400" MaxWidth="520"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtPacksTitle" Grid.Row="0" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <!-- карточки одинакового размера (300x262 с полями), на любом экране переносятся по ширине, текст их не растягивает -->
          <WrapPanel x:Name="PackList" Orientation="Horizontal" ItemWidth="300" ItemHeight="262" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
        <TextBlock x:Name="TxtEmpty" Grid.Row="1" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed"/>
      </Grid>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="48"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="24"/>
              <RowDefinition Height="18"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtMatchTitle" Grid.Row="0" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtSelectedPack" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="MatchList"/>
          </ScrollViewer>
          <TextBlock x:Name="TxtMatchSummary" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Панель действий: ряд 1 - кнопки, ряд 2 - галочки; все колонки заданы явно -->
    <Grid Grid.Row="2" Margin="28,4,28,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto" MinHeight="30"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnUpdate" Grid.Column="0" Style="{StaticResource AccentButton}" MinWidth="140" Margin="0,0,10,0"/>
        <Button x:Name="BtnUndo" Grid.Column="1" Style="{StaticResource GhostButton}" MinWidth="130" Margin="0,0,10,0"/>
        <Button x:Name="BtnOpen" Grid.Column="2" Style="{StaticResource GhostButton}" MinWidth="140" Margin="0,0,10,0"/>
        <Button x:Name="BtnMenu" Grid.Column="3" Style="{StaticResource GhostButton}" Content="⋯" MinWidth="44" Width="44" Padding="0"/>
        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12">
          <Hyperlink x:Name="LnkGitHub" NavigateUri="https://github.com/F1KS-FK/glyphix" Foreground="#7F9BFF" TextDecorations="None">GitHub</Hyperlink>
        </TextBlock>
      </Grid>
      <!-- галочки: в WrapPanel, на узком окне переносятся на вторую строку (строка действий - Auto, а не фиксированная высота) -->
      <WrapPanel Grid.Row="1" Orientation="Horizontal">
        <CheckBox x:Name="ChkRestart" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,24,3"/>
        <CheckBox x:Name="ChkAllUsers" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Margin="0,3,24,3"/>
        <CheckBox x:Name="ChkTiles" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,24,3" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkNoName" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Margin="0,3,24,3" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkAuto" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,3,0,3"/>
      </WrapPanel>
      <Popup x:Name="PopMenu" PlacementTarget="{Binding ElementName=BtnMenu}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="8">
          <StackPanel>
            <Button x:Name="BtnUninstall" Style="{StaticResource GhostButton}" MinWidth="180"/>
            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Opacity="0.75" HorizontalAlignment="Center" Margin="0,8,0,2">by F1KS · Telegram <Hyperlink x:Name="LnkAuthorMenu" NavigateUri="https://t.me/Im_Flawless" Foreground="#7F8FC8" TextDecorations="None">@Im_Flawless</Hyperlink></TextBlock>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- Статус и журнал: высота строки статуса фиксирована, длинный текст обрезается многоточием (полный - во всплывающей подсказке) -->
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="3"/>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ProgressBar x:Name="PrgBusy" Grid.Row="0" Height="3" Minimum="0" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
      <Grid Grid.Row="1" Margin="28,0,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedBrush}" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,14,0">by F1KS · Telegram <Hyperlink x:Name="LnkAuthor" NavigateUri="https://t.me/Im_Flawless" Foreground="#7F8FC8" TextDecorations="None">@Im_Flawless</Hyperlink></TextBlock>
        <Button x:Name="BtnLog" Grid.Column="2" Style="{StaticResource GhostButton}" Height="26" MinWidth="88" Padding="12,0" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="LogPanel" Grid.Row="2" Visibility="Collapsed" Margin="28,0,28,16" Background="#050815" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
        <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#AEB7E0" FontFamily="Consolas" FontSize="12" Padding="10,8"/>
      </Border>
    </Grid>
  </Grid>
</Window>
