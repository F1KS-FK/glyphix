<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glyphix" Width="1060" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#070A18"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#070A18"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1430"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1C2552"/>
    <SolidColorBrush x:Key="RowBrush" Color="#121A3D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A93BD"/>
    <SolidColorBrush x:Key="GhostBrush" Color="#141B3D"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#1D2757"/>
    <SolidColorBrush x:Key="GhostBorderBrush" Color="#2A3366"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#6A5CFF" Offset="0"/>
      <GradientStop Color="#3D8BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Основная кнопка: градиент + мягкое свечение -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#6A5CFF" Opacity="0.35" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="14"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмная вторичная кнопка -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="10" Background="#3D8BFF" Opacity="0" Margin="3,5,3,0">
                <Border.Effect>
                  <BlurEffect Radius="12"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0.25"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тёмные полосы прокрутки -->
    <Style x:Key="ScrollRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" CornerRadius="4" Background="#2A3366" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Background" Value="#3D4A8C"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollRepeat}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Шапка -->
    <Grid Grid.Row="0" Margin="28,20,28,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="ImgLogo" Grid.Column="0" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="GLYPHIX" FontSize="22" FontWeight="Bold">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#9C92FF" Offset="0"/>
              <GradientStop Color="#6DB0FF" Offset="1"/>
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>
        <TextBlock x:Name="TxtVersion" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,1,0,0"/>
      </StackPanel>
      <Border Grid.Column="2" Background="{StaticResource GhostBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
        <TextBlock x:Name="TxtAdmin" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </Border>
    </Grid>

    <!-- Основная часть -->
    <Grid Grid.Row="1" Margin="20,6,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtPacksTitle" Grid.Row="0" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <WrapPanel x:Name="PackList" Orientation="Horizontal"/>
        </ScrollViewer>
        <TextBlock x:Name="TxtEmpty" Grid.Row="1" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed"/>
      </Grid>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtMatchTitle" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtSelectedPack" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MatchList"/>
          </ScrollViewer>
          <TextBlock x:Name="TxtMatchSummary" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Нижняя панель -->
    <Grid Grid.Row="2" Margin="28,4,28,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <WrapPanel Grid.Column="0" Orientation="Horizontal">
        <Button x:Name="BtnUpdate" Style="{StaticResource AccentButton}" Margin="0,0,10,0"/>
        <Button x:Name="BtnUndo" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
        <Button x:Name="BtnOpen" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
        <Button x:Name="BtnMenu" Style="{StaticResource GhostButton}" Content="⋯" Padding="14,8" Margin="0,0,16,0"/>
        <CheckBox x:Name="ChkRestart" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkAllUsers" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <CheckBox x:Name="ChkTiles" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkNoName" Style="{StaticResource DarkCheck}" IsChecked="False" VerticalAlignment="Center" Visibility="Collapsed"/>
      </WrapPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12">
        <Hyperlink x:Name="LnkGitHub" NavigateUri="https://github.com/F1KS-FK/glyphix" Foreground="#7F9BFF" TextDecorations="None">GitHub</Hyperlink>
      </TextBlock>
      <Popup x:Name="PopMenu" PlacementTarget="{Binding ElementName=BtnMenu}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="8">
          <StackPanel>
            <Button x:Name="BtnUninstall" Style="{StaticResource GhostButton}"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- Статус и журнал -->
    <StackPanel Grid.Row="3" Margin="0,0,0,0">
      <ProgressBar x:Name="PrgBusy" Height="3" Minimum="0" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
      <Grid Margin="28,8,28,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <Button x:Name="BtnLog" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,4" FontSize="12"/>
      </Grid>
      <Border x:Name="LogPanel" Visibility="Collapsed" Margin="28,0,28,16" Background="#050815" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
        <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#AEB7E0" FontFamily="Consolas" FontSize="12" Padding="10,8"/>
      </Border>
    </StackPanel>
  </Grid>
</Window>
